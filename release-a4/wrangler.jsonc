{
  "name": "lexiconcore-pro",
  "main": "site.js",
  "compatibility_date": "2026-11-23",
  "build": {
    "command": "node build.mjs"
  },
  "services": [
    {
      "binding": "A3",
      "service": "anaproje"
    },
    {
      "binding": "MAIL",
      "service": "lexiconcore-support"
    }
  ]
}